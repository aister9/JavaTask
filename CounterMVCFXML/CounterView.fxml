<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>

<HBox alignment="CENTER" prefHeight="200" prefWidth="400" spacing="40" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="CounterMVCFXML.CounterController">

    <Label fx:id="countLabel" style="-fx-font-size: 32px; -fx-min-width: 120px; -fx-alignment: center;" />

    <Button fx:id="plusButton" onAction="#handleModelIncrement" style="-fx-font-size: 32px; -fx-pref-width: 100px; -fx-pref-height: 60px;" text="+" />

    <Button fx:id="resetButton" onAction="#handleModelReset" style="-fx-font-size: 24px; -fx-pref-width: 140px; -fx-pref-height: 60px;" text="reset" />

</HBox>
